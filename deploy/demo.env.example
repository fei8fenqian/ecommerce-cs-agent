# 复制到仓库根目录并命名为 .env；真实值只保存于服务器，绝不提交 Git。
ENV=prod
SEED_DEMO_USERS=false

PG_USER=app_user
PG_PASSWORD=replace_with_a_long_random_database_password
PG_DBNAME=ecommerce_agent

LLM_API_KEY=replace_with_your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 未配置时 /internal/metrics 不会暴露指标。
METRICS_BEARER_TOKEN=replace_with_a_long_random_metrics_token
MCP_SERVERS=[]
