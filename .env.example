# =============================================================================
# .env.example — 配置模板
# 复制为 .env 后填入真实值，.env 不进 git 也不进 Docker 镜像
# =============================================================================
ENV=prod

# PostgreSQL（docker-compose 自动注入 PG_HOST/PG_PORT）
PG_HOST=db
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_db_password_here
PG_DBNAME=postgres

# Embedding（首次启动自动下载模型，约 1.3GB）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# LLM API
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Redis（docker-compose 自动注入）
REDIS_URL=redis://redis:6379/0
SESSION_TTL=86400

# MCP 外部工具（可选）
MCP_SERVERS=[]

# 客服人工升级（可选；未配置时仍保留系统内人工队列）
FEISHU_DUTY_WEBHOOK_URL=
FEISHU_WORKBENCH_URL=http://localhost:5173/?page=login&next=tickets
FEISHU_ESCALATION_WORKER_ENABLED=false
FINANCE_ANOMALY_TIMEOUT_MINUTES=30

# UnionPay 5.1.0 U0 protocol smoke + U1 checkout test
# U0 CLI remains independent; U1 checkout uses the same server-side protocol client.
UNIONPAY_MER_ID=
UNIONPAY_SIGN_CERT_PATH=.secrets/unionpay/acp_test_sign.pfx
UNIONPAY_SIGN_CERT_PASSWORD=
UNIONPAY_ROOT_CERT_PATH=.secrets/unionpay/acp_test_root.cer
UNIONPAY_MIDDLE_CERT_PATH=.secrets/unionpay/acp_test_middle.cer
UNIONPAY_ENCRYPT_CERT_PATH=.secrets/unionpay/acp_test_enc.cer
# U1.1 public FastAPI front-return base URL; keep empty until a public HTTPS tunnel is ready.
UNIONPAY_PUBLIC_BASE_URL=
UNIONPAY_FRONT_GATEWAY=https://gateway.test.95516.com/gateway/api/frontTransReq.do
UNIONPAY_QUERY_GATEWAY=https://gateway.test.95516.com/gateway/api/queryTrans.do
UNIONPAY_BACK_GATEWAY=https://gateway.test.95516.com/gateway/api/backTransReq.do
