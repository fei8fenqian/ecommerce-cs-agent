# =============================================================================
# .env.example — 配置模板
# 复制为 .env 后填入真实值，.env 不进 git 也不进 Docker 镜像
# =============================================================================
ENV=prod

# PostgreSQL（docker-compose 自动注入 PG_HOST/PG_PORT）
PG_HOST=db
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_db_password_here
PG_DBNAME=postgres

# Embedding（首次启动自动下载模型，约 1.3GB）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# LLM API
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Redis（docker-compose 自动注入）
REDIS_URL=redis://redis:6379/0
SESSION_TTL=86400

# MCP 外部工具（可选）
MCP_SERVERS=[]
