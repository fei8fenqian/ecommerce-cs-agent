ENV=dev

# PostgreSQL
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=  # 改成你的数据库密码
PG_DBNAME=postgres

# Embedding
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# LLM（Phase 3 用，先占位）
LLM_API_KEY=  # DeepSeek API Key，从 https://platform.deepseek.com 获取
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# 检索参数
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5